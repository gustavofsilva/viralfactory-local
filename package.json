{
  "name": "viralfactory-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --production",
    "db:setup": "node scripts/db.mjs",
    "build": "npm run typecheck && npm run build --workspace @viralfactory/web",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "tsx --test apps/api/test/*.test.ts",
    "test:clips": "tsx scripts/clip-smoke.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:extension": "node scripts/extension-check.mjs",
    "doctor": "tsx scripts/doctor.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.2.0"
  }
}
