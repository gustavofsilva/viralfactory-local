{
  "manifest_version": 3,
  "name": "ViralFactory — conexão local",
  "version": "0.1.9",
  "description": "Conecta uma aba autorizada do TikTok ao ViralFactory Local. A sessão permanece no Chrome.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ViralFactory Local" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:*" }
}
